pipeline {
    agent any

    environment {
        SSH_CRED    = 'nodekey'
        SERVER_IP   = '52.53.202.92'
        REMOTE_USER = 'ec2-user'
        APP_DIR     = '/home/ec2-user/shared-jenkins/nodeapp/node-shared-jenkins-infra'
    }

    stages {

        stage('Deploy to Server') {
            steps {
                sshagent(credentials: [SSH_CRED]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${SERVER_IP} '

                            mkdir -p ${APP_DIR}
                            cd ${APP_DIR}

                            git pull origin main

                            docker rm -f nodecont || true

                            docker build -f Dockerfile -t nodeimg .

                            docker run -d \
                                -p 3000:3000 \
                                --name nodecont \
                                nodeimg
                        '
                    """
                }
            }
        }

        stage('Validate') {
            steps {
                sshagent(credentials: [SSH_CRED]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${SERVER_IP} '
                            docker images
                            docker ps
                        '
                    """
                }
            }
        }
    }

    post {
        success {
            echo '========================================'
            echo 'NODE.JS APPLICATION DEPLOYED SUCCESSFULLY!'
            echo '========================================'
        }

        failure {
            echo '========================================'
            echo 'NODE.JS APPLICATION DEPLOYMENT FAILED!'
            echo '========================================'
        }

        always {
            echo 'Node.js pipeline execution completed.'
        }
    }
}

